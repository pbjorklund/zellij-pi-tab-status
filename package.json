{
  "name": "zellij-pi-tab-status",
  "version": "0.1.0",
  "type": "module",
  "description": "Show PI activity and unseen completion in the owning Zellij tab title.",
  "exports": {
    ".": "./pi-extension.ts",
    "./pi-extension": "./pi-extension.ts"
  },
  "files": [
    "pi-extension.ts",
    "lib"
  ],
  "scripts": {
    "test": "node --test test/*.mjs",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-lines=95 --test-coverage-branches=95 --test-coverage-functions=95 --test-coverage-include='lib/*.ts' --test-coverage-include=pi-extension.ts test/*.mjs",
    "test:smoke": "python e2e/run.py LiveTabStatus.test_parent_completion_seen_and_shutdown",
    "test:e2e": "python -m unittest discover -s e2e -p 'test_*.py' && python e2e/run.py",
    "eval": "python evals/tab-status/run.py"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/pbjorklund/zellij-pi-tab-status.git"
  },
  "bugs": {
    "url": "https://github.com/pbjorklund/zellij-pi-tab-status/issues"
  },
  "homepage": "https://github.com/pbjorklund/zellij-pi-tab-status#readme",
  "pi": {
    "extensions": [
      "./pi-extension.ts"
    ]
  }
}
